{"as_of": "2026-10-21", "last_updated_at": "2026-10-22T02:27+09:00", "today": [], "recent": [{"id": "6f52c10b0d2f257c9d1818bc", "title": "Regulatory Considerations for Prescription Drug Use-Related Software; Guidance for Industry; Availability", "country": "미국", "facility_country": "", "agency": "FDA", "published_date": "2026-10-21", "source_title": "FDA 공고·가이드라인", "source_type": "FDA 공고·가이드라인", "company": "", "cfr": "", "ai_summary": "FDA는 처방의약품 사용 관련 소프트웨어 출력물에 의약품 라벨링 권한을 적용하는 방식을 설명하는 최종 가이드라인 'Regulatory Considerations for Prescription Drug Use-Related Software'의 발간을 공고했다. 2023-09-19 초안을 확정한 것이며, 수집 자료는 관보 요약 수준이다.", "source_summary": "The Food and Drug Administration (FDA or Agency) is announcing the availability of a final guidance for industry titled \"Regulatory Considerations for Prescription Drug Use-Related Software.\" This final guidance describes FDA's application of its drug labeling authorities to certain software outputs that are disseminated by or on behalf of a drug sponsor for use with a prescription drug product or a prescription drug-led, drug-device combination product that is assigned to the Center for Drug Evaluation and Research or the Center for Biologics Evaluation and Research as the lead center. This guidance finalizes the draft guidance of the same title issued on September 19, 2023.", "summary_provider": "claude", "summary_model": "claude-code-action", "summary_status": "success", "summary_coverage": "structured_excerpt", "summary_quality": "automated_checks_only", "summary_review": {"method": "근거 인용 자동 일치 검사 · 독립 검수 아님", "reviewed_at": "2026-10-21", "scope": "공식 구조화 필드와 근거 인용을 자동 대조했습니다. 원문 전체의 사람 검수를 뜻하지 않습니다.", "source_url": "https://www.federalregister.gov/documents/2026/10/21/2026-21516/regulatory-considerations-for-prescription-drug-use-related-software-guidance-for-industry", "visual_review": false}, "change_summary": "FDA는 처방의약품 사용 관련 소프트웨어 출력물에 의약품 라벨링 권한을 적용하는 방식을 설명하는 최종 가이드라인 'Regulatory Considerations for Prescription Drug Use-Related Software'의 발간을 공고했다. 2023-09-19 초안을 확정한 것이며, 수집 자료는 관보 요약 수준이다.", "impact_summary": "", "background": "", "purpose": "", "changes_before": "", "changes_after": "", "affected_work": "", "recommendation": "", "key_quote": "", "importance": "보통", "tags": "RA", "created_at": "2026-10-21", "link": "https://www.federalregister.gov/documents/2026/10/21/2026-21516/regulatory-considerations-for-prescription-drug-use-related-software-guidance-for-industry", "content_scope": "guidance", "scope_reason": "규정·가이드라인 유형 또는 명시적 GMP 단서", "topics": [], "classification_method": "source-keywords-v1", "classification_status": "pending", "inspection_end_date": "", "official_published_at": "", "first_seen_at": "2026-10-21", "last_collected_at": "2026-10-21", "collection_mode": "daily", "investigators": [], "source_link": {"kind": "document", "label": "공식 자료 열기", "url": "https://www.federalregister.gov/documents/2026/10/21/2026-21516/regulatory-considerations-for-prescription-drug-use-related-software-guidance-for-industry"}, "fei": "", "inspection_id": "", "facility_address": "", "record_kind": "document", "link_check": {"status": "http_ok", "http_status": 206}, "source_collection_status": "", "document_resolution": null}, {"id": "ad22056dfff4e404e4665283", "title": "(주)현진제약 '현진절패모' 회수 — 중금속(카드뮴)", "country": "한국", "facility_country": "", "agency": "식약처", "published_date": "2026-10-21", "source_title": "(주)현진제약", "source_type": "식약처 회수·폐기", "company": "(주)현진제약", "cfr": "", "ai_summary": "(주)현진제약 '현진절패모'가 중금속(카드뮴) 사유로 2026-10-21 회수명령을 받았다. 수집 자료에는 검출 수치와 회수 등급이 없다.", "source_summary": "중금속(카드뮴)", "summary_provider": "claude", "summary_model": "claude-code-action", "summary_status": "success", "summary_coverage": "structured_excerpt", "summary_quality": "automated_checks_only", "summary_review": {"method": "근거 인용 자동 일치 검사 · 독립 검수 아님", "reviewed_at": "2026-10-21", "scope": "공식 API·목록의 구조화 필드와 근거 인용을 자동 대조했습니다. 연결 문서 전문의 사람 검수를 뜻하지 않습니다.", "source_url": "https://nedrug.mfds.go.kr