ion_status": "", "document_resolution": null}], "ema_recent": {"id": "5c6290256b4e9f3cef980a56", "title": "Annual report of the Pharmacovigilance Inspectors Working Group for 2025", "country": "EU", "facility_country": "", "agency": "EMA", "published_date": "2026-10-09", "source_title": "EMA 실사", "source_type": "EMA 실사", "company": "", "cfr": "", "ai_summary": "EMA 연례보고서는 2025년 중앙허가 의약품 약물감시 실사에서 인체용 88건, 수의용 23건의 결함이 확인됐고, 중대 결함은 각각 35건과 10건이라고 집계했다. 인체용에서는 이상반응 관리·보고, 품질시스템, 전산시스템이 주요 지적 영역이었으며 수의용은 품질시스템 결함이 가장 많았다. 이는 허가권자(MAH)의 약물감시 시스템과 보고·품질관리 업무가 실사 중점임을 보여준다.", "source_summary": "Annual report of the Pharmacovigilance Inspectors Working Group for 2025", "summary_provider": "codex", "summary_model": "gpt-6-luna", "summary_status": "success", "summary_coverage": "extracted_body", "summary_quality": "automated_checks_only", "summary_review": {"method": "Codex GPT 요약 + 원문 근거 문구 자동 일치 검사", "reviewed_at": "2026-10-15", "scope": "EMA 실사의 공식 구조화 필드와 기관 제공 문구를 검토했습니다. 원문 전체 검토로 표시하지 않습니다.", "visual_review": false}, "change_summary": "EMA 연례보고서는 2025년 중앙허가 의약품 약물감시 실사에서 인체용 88건, 수의용 23건의 결함이 확인됐고, 중대 결함은 각각 35건과 10건이라고 집계했다. 인체용에서는 이상반응 관리·보고, 품질시스템, 전산시스템이 주요 지적 영역이었으며 수의용은 품질시스템 결함이 가장 많았다. 이는 허가권자(MAH)의 약물감시 시스템과 보고·품질관리 업무가 실사 중점임을 보여준다.", "impact_summary": "", "background": "", "purpose": "", "changes_before": "", "changes_after": "", "affected_work": "", "recommendation": "", "key_quote": "", "importance": "보통", "tags": "QA, RA", "created_at": "2026-10-09", "link": "https://www.ema.europa.eu/system/files/documents/annual-report/annual-report-pharmacovigilance-inspectors-working-group-2025-en.pdf", "practical_review": {"impact_summary": {"status": "found", "value": "보고서는 2025년 약물감시 실사 프로그램과 주요 관찰 결과를 요약합니다. 중앙 허가 의약품 관련 인체용 실사에서는 중대한 결함 35건과 경미한 결함 53건, 수의용 실사에서는 중대한 결함 10건과 경미한 결함 13건이 기록됐습니다.", "evidence": [{"field": "상세.본문발췌", "quote": "A total of 88 deficiencies, comprising 0 critical, 35 major (39.8%) and 53 minor (60.2%) findings were recorded for the CHMP requested human medicines pharmacovigilance inspections conducted in 2025"}, {"field": "상세.본문발췌", "quote": "A total of 23 deficiencies, comprising 0 critical, 10 major (43.48%) and 13 minor (56.52%) findings were recorded for the CVMP requested veterinary medicines pharmacovigilance inspections conducted in 2025"}]}, "affected_work": {"status": "found", "value": "EMA 약물감시 실사관 작업반과 인체용·수의용 중앙 허가 의약품의 시판 허가권자(MAH)를 대상으로 한 실사 프로그램 및 조정 활동을 다룹니다.", "evidence": [{"field": "상세.본문발췌", "quote": "The focus of these inspections is to determine whether the MAH has the personnel, systems, and facilities in place to meet its regulatory pharmacovigilance obligations for CAPs in the EEA."}, {"field": "상세.본문발췌", "quote": "The PhV IWG focuses on the harmonisation and coordination of pharmacovigilance-related activities at EU (hereinafter the \"Union\") level."}]}, "recommendation": {"status": "not_stated", "value": "", "evidence": []}, "effective_date": {"status": "not_stated", "value": "", "evidence": []}, "response_deadline": {"status": "not_stated", "value": "", "evidence": []}, "reviewed_at": "2026-10-19", "model": "gpt-6-luna", "source_url": "https://www.ema.europa.eu/system/files/documents/annual-report/annual-report-pharmacovigilance-inspectors-working-group-2025-en.pdf", "scope": "확보한 본문 기준 · 첨부 및 미확보 페이지는 제외 · 자동 추출"}, "content_scope": "guidance", "scope_reason": "실사·GMP 전문 출처", "topics": ["deviation-capa"], "classification_method": "source-keywords-v1", "classification_status": "rule_matched", "inspection_end_date": "", "official_published_at": "", "first_seen_at": "2026-10-10", "last_collected_at": "2026-10-15", "collection_mode": "daily", "investigators": [], "source_link": {"kind": "pdf", "label": "공식 PDF 열기", "url": "https://www.ema.europa.eu/system/files/documents/annual-report/annual-report-pharmacovigilance-inspectors-working-group-2025-en.pdf"}, "fei": "", "inspection_id": "", "facility_address": "", "record_kind": "document", "link_check": {"status": "content_ext