{"as_of": "2026-10-09", "last_updated_at": "2026-10-10T15:31+09:00", "today": [], "recent": [{"id": "5ac6ee77e49f51b7e755b6f2", "title": "Requirements for Additional Traceability Records for Certain Foods: Enforcement Policy for Certain Retail Food Establishments and Restaurants; Draft Guidance for Industry; Availability", "country": "미국", "facility_country": "", "agency": "FDA", "published_date": "2026-10-09", "source_title": "FDA 공고·가이드라인", "source_type": "FDA 공고·가이드라인", "company": "", "cfr": "", "ai_summary": "FDA가 '특정 식품에 대한 추가 추적 기록 요건' 규정 중 일부 소매 식품 시설 및 레스토랑에 적용되는 요건에 대해, 현재의 위험 이해에 근거해 일부 대상·활동에는 집행하지 않겠다는 의향을 담은 산업체 대상 가이드라인 초안의 공개를 알린 공고이다. 수집 자료는 공고 요약 발췌이며 가이드라인 본문 전체는 확인하지 않았다.", "source_summary": "The Food and Drug Administration (FDA, we, or the Agency) is announcing the availability of a draft guidance for industry titled \"Requirements for Additional Traceability Records for Certain Foods: Enforcement Policy for Certain Retail Food Establishments and Restaurants.\" The draft guidance states that, at this time and based on our current understanding of the risks, FDA does not intend to enforce certain regulatory requirements as they apply to certain entities and/or activities. The applicable requirements are established in our regulation titled \"Requirements for Additional Traceability Records for Certain Foods.\"", "summary_provider": "claude", "summary_model": "claude-code-action", "summary_status": "success", "summary_coverage": "structured_excerpt", "summary_quality": "automated_checks_only", "summary_review": {"method": "근거 인용 자동 일치 검사 · 독립 검수 아님", "reviewed_at": "2026-10-09", "scope": "공식 구조화 필드와 근거 인용을 자동 대조했습니다. 원문 전체의 사람 검수를 뜻하지 않습니다.", "source_url": "https://www.federalregister.gov/documents/2026/10/09/2026-20721/requirements-for-additional-traceability-records-for-certain-foods-enforcement-policy-for-certain", "visual_review": false}, "change_summary": "FDA가 '특정 식품에 대한 추가 추적 기록 요건' 규정 중 일부 소매 식품 시설 및 레스토랑에 적용되는 요건에 대해, 현재의 위험 이해에 근거해 일부 대상·활동에는 집행하지 않겠다는 의향을 담은 산업체 대상 가이드라인 초안의 공개를 알린 공고이다. 수집 자료는 공고 요약 발췌이며 가이드라인 본문 전체는 확인하지 않았다.", "impact_summary": "", "background": "", "purpose": "", "changes_before": "", "changes_after": "", "affected_work": "", "recommendation": "", "key_quote": "", "importance": "보통", "tags": "RA", "created_at": "2026-10-09", "link": "https://www.federalregister.gov/documents/2026/10/09/2026-20721/requirements-for-additional-traceability-records-for-certain-foods-enforcement-policy-for-certain", "content_scope": "guidance", "scope_reason": "규정·가이드라인 유형 또는 명시적 GMP 단서", "topics": [], "classification_method": "source-keywords-v1", "classification_status": "pending", "inspection_end_date": "", "official_published_at": "", "first_seen_at": "2026-10-09", "last_collected_at": "2026-10-09", "collection_mode": "daily", "investigators": [], "source_link": {"kind": "document", "label": "공식 자료 열기", "url": "https://www.federalregister.gov/documents/2026/10/09/2026-20721/requirements-for-additional-traceability-records-for-certain-foods-enforcement-policy-for-certain"}, "fei": "", "inspection_id": "", "facility_address": "", "record_kind": "document", "link_check": {"status": "http_ok", "http_status": 206}, "source_collection_status": "", "document_resolution": null}, {"id": "5c6290256b4e9f3cef980a56", "title": "Annual report of the Pharmacovigilance Inspectors Working Group for 2025", "country": "EU", "facility_country": "", "agency": "EMA", "published_date": "2026-10-09", "source_title": "EMA 실사", "source_type": "EMA 실사", "company": "", "cfr": "", "ai_summary": "EMA 약물감시 실사관 작업그룹(PhV IWG)의 2025년 연례 보고서로, 2025년 CHMP 요청 인체의약품 약물감시 실사에서 결함 88건(중대 0, 주요 35, 경미 53)이 기록되었다고 보고한다. 결함이 많았던 영역은 이상반응 관리·보고, QMS, 전산시스템 순이며, 수의 분야 CVMP 요청 실사에서는 23건(중대 0, 주요 10, 경미 13)이 기록되었고 QMS가 가장 많았다.", "source_summary": "Annual report of the Pharmacovigilance Inspectors Working Group for 2025", "summary_provider": "claude", "summary_model": "claude-code-action", "summary_status": "success", "summary_coverage": "ex