{"as_of": "2026-09-17", "last_updated_at": "2026-09-17T14:21+09:00", "today": [{"id": "681579baa04a5fa59c710ce4", "title": "Recommendations for the Development of Blood Collection, Processing, and Storage Systems for the Manufacture of Blood Components Using the Buffy Coat Method; Guidance for Industry; Availability", "country": "미국", "facility_country": "", "agency": "FDA", "published_date": "2026-09-17", "source_title": "FDA 공고·가이드라인", "source_type": "FDA 공고·가이드라인", "company": "", "cfr": "", "ai_summary": "", "source_summary": "The Food and Drug Administration (FDA or Agency) is announcing the availability of a final guidance titled \"Recommendations for the Development of Blood Collection, Processing, and Storage Systems for the Manufacture of Blood Components Using the Buffy Coat Method.\" The guidance document provides recommendations on the development of blood collection, processing, and storage systems (e.g., blood bags with anticoagulant and additive solutions, empty bags for platelet pooling) intended for the manufacture of blood and blood components for transfusion using the buffy coat (BC) method and on regulatory submissions to FDA for such products. This guidance is intended for manufacturers of blood collection, processing, and storage systems. The guidance announced in this notice finalizes the draft guidance of the same title dated October 18, 2024.", "summary_provider": "source", "summary_model": "", "summary_status": "fallback", "summary_coverage": "structured_excerpt", "summary_quality": "automated_checks_only", "summary_review": null, "change_summary": "The Food and Drug Administration (FDA or Agency) is announcing the availability of a final guidance titled \"Recommendations for the Development of Blood Collection, Processing, and Storage Systems for the Manufacture of Blood Components Using the Buffy Coat Method.\" The guidance document provides recommendations on the development of blood collection, processing, and storage systems (e.g., blood bags with anticoagulant and additive solutions, empty bags for platelet pooling) intended for the manufacture of blood and blood components for transfusion using the buffy coat (BC) method and on regulatory submissions to FDA for such products. This guidance is intended for manufacturers of blood collection, processing, and storage systems. The guidance announced in this notice finalizes the draft guidance of the same title dated October 18, 2024.", "impact_summary": "", "background": "", "purpose": "", "changes_before": "", "changes_after": "", "affected_work": "", "recommendation": "", "key_quote": "", "importance": "보통", "tags": "", "created_at": "2026-09-17", "link": "https://www.federalregister.gov/documents/2026/09/17/2026-19080/recommendations-for-the-development-of-blood-collection-processing-and-storage-systems-for-the", "content_scope": "guidance", "scope_reason": "규정·가이드라인 유형 또는 명시적 GMP 단서", "topics": [], "classification_method": "source-keywords-v1", "classification_status": "pending", "inspection_end_date": "", "official_published_at": "", "first_seen_at": "2026-09-17", "last_collected_at": "2026-09-17", "collection_mode": "daily", "investigators": [], "source_link": {"kind": "document", "label": "공식 자료 열기", "url": "https://www.federalregister.gov/documents/2026/09/17/2026-19080/recommendations-for-the-development-of-blood-collection-processing-and-storage-systems-for-the"}, "fei": "", "inspection_id": "", "facility_address": "", "record_kind": "document", "link_check": {}, "document_resolution": null}], "recent": [{"id": "681579baa04a5fa59c710ce4", "title": "Recommendations for the Development of Blood Collection, Processing, and Storage Systems for the Manufacture of Blood Components Using the Buffy Coat Method; Guidance for Industry; Availability", "country": "미국", "facility_country": "", "agency": "FDA", "published_date": "2026-09-17", "source_title": "FDA 공고·가이드라인", "source_type": "FDA 공고·가이드라인", "company": "", "cfr": "", "ai_summary": "", "sourc