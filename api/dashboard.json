ce_title": "FDA 공고·가이드라인", "source_type": "FDA 공고·가이드라인", "company": "", "cfr": "", "ai_summary": "FDA는 이보가인(ibogaine) 의약품의 초기 임상시험 설계 접근 방식을 설명하고, 용량 선택·증량, 진료 환경, 안전성 모니터링, 선정 기준, 중단 규칙, 안전 감독 등에 대해 공개 의견을 받는 정보요청(RFI) 공고를 게시했다. 수집 자료는 공고 요약 발췌이며, 이 의견이 이보가인 IND 심사에 어떻게 반영될지는 FDA가 의견을 검토해 판단한다고 되어 있다.", "summary_provider": "claude", "summary_model": "claude-code-action", "summary_status": "success", "summary_coverage": "structured_excerpt", "summary_quality": "automated_checks_only", "summary_review": null, "impact_summary": "", "background": "", "purpose": "", "changes_before": "", "changes_after": "", "affected_work": "", "recommendation": "", "key_quote": "", "importance": "낮음", "tags": "RA", "created_at": "2026-10-06", "link": "https://www.federalregister.gov/documents/2026/10/06/2026-20427/design-and-safety-considerations-for-clinical-trials-involving-ibogaine-drug-products-request-for", "content_scope": "guidance", "scope_reason": "규정·가이드라인 유형 또는 명시적 GMP 단서", "topics": [], "classification_method": "source-keywords-v1", "classification_status": "pending", "inspection_end_date": "", "official_published_at": "", "first_seen_at": "2026-10-07", "last_collected_at": "2026-10-07", "collection_mode": "daily", "investigators": [], "source_link": {"kind": "document", "label": "공식 자료 열기", "url": "https://www.federalregister.gov/documents/2026/10/06/2026-20427/design-and-safety-considerations-for-clinical-trials-involving-ibogaine-drug-products-request-for"}, "fei": "", "inspection_id": "", "facility_address": "", "record_kind": "document", "link_check": {}, "source_collection_status": "", "document_resolution": null}, {"id": "f9b029d95110c41838d0eb87", "title": "Immune Support Echinacea Plus, 60 Film Coated Tablets", "country": "호주", "facility_country": "", "agency": "TGA", "published_date": "2026-10-06", "source_title": "TGA 시장조치", "source_type": "TGA 시장조치", "company": "", "cfr": "", "ai_summary": "TGA 시장조치 데이터베이스에 'Immune Support Echinacea Plus, 60 Film Coated Tablet