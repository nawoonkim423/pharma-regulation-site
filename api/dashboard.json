opics": [], "classification_method": "source-keywords-v1", "classification_status": "reference", "inspection_end_date": "", "official_published_at": "", "first_seen_at": "2026-11-16", "last_collected_at": "2026-11-16", "collection_mode": "daily", "investigators": [], "source_link": {"kind": "document", "label": "공식 자료 열기", "url": "https://www.mfds.go.kr/brd/m_99/view.do?seq=50494"}, "fei": "", "inspection_id": "", "facility_address": "", "record_kind": "document", "link_check": {"status": "content_extracted"}, "source_collection_status": "extracted", "document_resolution": null}, {"id": "69c5ccea9ca3cd034d6c9a3d", "title": "Anvisa autoriza adequação de pedidos para agilizar importação de medicamentos por pessoas físicas", "country": "브라질", "facility_country": "", "agency": "ANVISA", "published_date": "2026-11-14", "source_title": "ANVISA 의약품 공지", "source_type": "ANVISA 의약품 공지", "company": "", "cfr": "", "ai_summary": "ANVISA는 사법 결정에 따라 특정 환자용 의약품을 기업·보험사가 수입하는 경우, 개인(pessoa física) 수입으로 제출된 신청과 서류를 활용해 분석을 이어갈 수 있게 하는 예외적·임시 조치를 승인했다고 공지했다. 대상은 미등록 의약품과 국내 유통이 불가한 등록 의약품 중 지정된 환자·의료기관용이며, RDC 488/2021은 계속 유효하고 RDC 81/2008 12장 개정을 위한 공개 협의 제안이 예정되어 있다고 한다. 연결된 페이지 본문 기준이며 첨부는 확인하지 않았다.", "source_summary": "Medida excepcional e temporária permite que importação solicitada por empresas pelo canal de pessoa física possam ser analisadas", "summary_provider": "claude", "summary_model": "claude-code-action", "summary_status": "success", "summary_coverage": "extracted_body", "summary_quality": "automated_checks_only", "summary_review": {"method": "근거 인용 자동 일치 검사 · 독립 검수 아님", "reviewed_at": "2026-11-15", "scope": "공식 링크에서 추출한 본문과 근거 인용을 자동 대조했습니다. 문서 전체의 사람 검수를 뜻하지 않습니다.", "source_url": "https://www.gov.br/anvisa/pt-br/assuntos/noticias-anvisa/anvisa-autoriza-adequacao-de-pedidos-para-agilizar-importacao-de-medicamentos-por-pessoas-fisicas", "visual_review": false}, "change_summary": "ANVISA는 사법 결정에 따라 특정 환자용 의약품을 기업·보험사가 수입하는 경우, 개인(pessoa física) 수입으로 제출된 신청과 서류를 활용해 분석을 이어갈 수 있게 하는 예외적·임시 조치를 승인했다고 공지했다. 대상은 미등록 의약품과 국내 유통이 불가한 등록 의약품 중 지정된 환자·의료기관용이며, RDC 488/2021은 계속 유효하고 RDC 81/2008 12장 개정을 위한 공개 협의 제안이 예정되어 있다고 한다. 연결된 페이지 본문 기준이며 첨부는 확인하지 않았다.", "impact_summary": "", "background": "", "purpose": "", "changes_before": "", "changes_after": "", "affected_work": "", "recommendation": "", "key_quote": "", "importance": "보통", "tags": "RA", "created_at": "2026-11-14", "link": "https://www.gov.br/anvisa/pt-br/assuntos/noticias-anvisa/anvisa-autoriza-adequacao-de-pedidos-para-agilizar-importacao-de-medicamentos-por-pessoas-fisicas", "practical_review": {"impact_summary": {"status": "found", "value": "사법 결정에 따른 환자 개별 의약품 수입에서, 개인 수입으로 제출된 서류를 활용해 분석을 계속할 수 있도록 하는 예외적·임시 조치이며 자동 승인이나 등록과는 다르다.", "evidence": [{"field": "상세.본문발췌", "quote": "A medida não implica liberação automática nem equivale ao registro sanitário do medicamento no país."}]}, "affected_work": {"status": "found", "value": "미등록 의약품과 국내 시장에서 구할 수 없는 등록 의약품 중, 지정된 환자와 지정된 의료기관 전용 수입 건이 대상이다.", "evidence": [{"field": "상세.본문발췌", "quote": "A autorização abrange, nas condições da deliberação, medicamentos sem registro na Anvisa e medicamentos registrados que estejam indisponíveis no mercado nacional"}]}, "recommendation": {"status": "found", "value": "RDC 488/2021 절차는 해당 요건의 수입에 계속 사용해야 하며, 예외 수입 시 구매·수입 업체는 위생 책임을 명시적으로 지고 적합한 사업장 허가를 제출해야 한다.", "evidence": [{"field": "상세.본문발췌", "quote": "O procedimento da Resolução da Diretoria Colegiada (RDC) nº 488/2021 permanece vigente e deve ser utilizado nas operações que se enquadrem em suas hipóteses."}]}, "effective_date": {"status": "not_stated", "value": "", "evidence": []}, "response_deadline": {"status": "not_stated", "value": "", "evidence": []}, "reviewed_at": "2026-11-15", "model": "claude-code-action", "source_url": "https://www.gov.br/anvisa/pt-br/assuntos/noticias-anvisa/anvisa-autoriza-adequacao-de-pedidos-para-agilizar-importacao-de-medicamentos-por-pessoas-fisicas", "scope": "확보한 본문 기준 · 첨부 및 미확보 페이지는 제외 · 자동 추출"}, "content_scope": "reference", "scope_reason": "일반 정책·안전성·공급 참고 자료", "topics": [], "classification_method": "source-keywords-v1", "classification_status": "reference", "inspection_end_date": "", "official_published_at": "2026-11-14", "first_seen_at": "2026-11-15", "last_collected_at": "2026-11-15", "collection_mode": "daily", "investigators": [], "source_link": {"kind": "document", "label": "공식 자료 열기", "url": "https://www.gov.br/anvisa/pt-br/assuntos/noticias-anvisa/anvisa-autoriza-adequacao-de-pedidos-para-agilizar-importacao-de-medicamentos-por-pessoas-fisicas"}, "fei": "", "inspection_id": "", "facility_address": "", "record_kind": "document", "link_check": {"status": "content_extracted"}, "source_collection_status": "extracted", "document_resolution": null}, {"id": "798d680b022f568408438f10", "title": "Determination That DIBENZYLINE (Phenoxybenzamine Hydrochloride) Oral Capsule, 10 Milligrams, and Other Drug Products Were Not Withdrawn From Sale for Reasons of Safety or Effectiveness", "country": "미국", "facility_country": "", "agency": "FDA", "published_date": "2026-11-13", "source_title": "FDA 공고·가이드라인", "source_type": "FDA 공고·가이드라인", "company": "", "cfr": "", "ai_summary": "연방관보 공고로, FDA는 DIBENZYLINE(phenoxybenzamine HCl) 경구 캡슐 10mg 등 목록의 의약품이 안전성·유효성 사유로 판매 철회된 것이 아니라고 결정했다. 이에 따라 해당 제품을 참조하는 ANDA의 승인 철회 절차를 시작하지 않으며, 관련 요건을 충족하면 ANDA 승인을 계속할 수 있다. 수집된 요약 필드 기준이며 관보 전문은 검토하지 않았다.", "source_summary": "The Food and Drug Administration (FDA or Agency) has determined that the drug products listed in this document were not withdrawn from sale for reasons of safety or effectiveness. This determination means that FDA will not begin procedures to withdraw approval of abbreviated new drug applications (ANDAs) that refer to these drug products, and it will allow FDA to continue to approve ANDAs that refer to the products as long as they meet relevant legal and regulatory requirements.", "summary_provider": "claude", "summary_model": "claude-code-action", "summary_status": "suc