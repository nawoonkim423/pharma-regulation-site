: "", "facility_address": "", "record_kind": "document", "link_check": {"status": "content_extracted"}, "source_collection_status": "extracted", "document_resolution": null}, {"id": "587ee161ab2ad7f7c36e8492", "title": "Alkem Laboratories Limited — Warning Letter (Drugs/CDER)", "country": "미국", "facility_country": "인도", "agency": "FDA", "published_date": "2026-11-18", "source_title": "Alkem Laboratories Limited", "source_type": "FDA Warning Letter", "company": "Alkem Laboratories Limited", "cfr": "", "ai_summary": "Warning Letter(Alkem Laboratories Limited, 인도 Daman, CDER, 2026-11-18 발송) 본문 기준으로 2026-04-20~05-01 실사에서 확인된 CGMP 위반이 기재되었다. 불일치·OOS·OOT 용출 결과 및 불만 조사 실패(21 CFR 211.192), 생산·공정 관리 절차 미흡(21 CFR 211.100(a)), 설비 세척·유지 절차 미흡(21 CFR 211.67(b))이며, FDA는 2026-05-22자 업체 회신을 부적절하다고 평가했다. 수집된 것은 연결 페이지 본문이며 첨부는 포함되지 않았다.", "source_summary": "Alkem Laboratories Limited — Warning Letter (Drugs/CDER)", "summary_provider": "claude", "summary_model": "claude-code-action", "summary_status": "success", "summary_coverage": "extracted_body", "summary_quality": "automated_checks_only", "summary_review": {"method": "근거 인용 자동 일치 검사 · 독립 검수 아님", "reviewed_at": "2026-11-25", "scope": "공식 링크에서 추출한 본문과 근거 인용을 자동 대조했습니다. 문서 전체의 사람 검수를 뜻하지 않습니다.", "source_url": "https://www.fda.gov/inspections-compliance-enforcement-and-criminal-investigations/warning-letters/alkem-laboratories-limited-736113-11182026", "visual_review": false}, "change_summary": "Warning Letter(Alkem Laboratories Limited, 인도 Daman, CDER, 2026-11-18 발송) 본문 기준으로 2026-04-20~05-01 실사에서 확인된 CGMP 위반이 기재되었다. 불일치·OOS·OOT 용출 결과 및 불만 조사 실패(21 CFR 211.192), 생산·공정 관리 절차 미흡(21 CFR 211.100(a)), 설비 세척·유지 절차 미흡(21 CFR 211.67(b))이며, FDA는 2026-05-22자 업체 회신을 부적절하다고 평가했다. 수집된 것은 연결 페이지 본문이며 첨부는 포함되지 않았다.", "impact_summary": "", "background": "", "purpose": "", "changes_before": "", "changes_after": "", "affected_work": "", "recommendation": "", "key_quote": "", "importance": "높음", "tags": "QA, QC, 생산", "created_at": "2026-11-18", "link": "https://www.fda.gov/inspections-compliance-enforcement-and-criminal-investigations/warning-letters/alkem-laboratories-limited-736113-11182026", "practical_review": {"impact_summary": {"status": "found", "value": "OOS·OOT 용출 결과와 불만에 대한 조사 실패, 공정 변수의 과학적 근거 없는 설정·변경, 설비 손상·세척 관리 미흡이 CGMP 위반으로 지적되었다.", "evidence": [{"field": "상세.본문발췌", "quote": "Your firm failed to thoroughly investigate any unexplained discrepancy or failure of a batch or any of its components to meet any of its specifications"}]}, "affected_work": {"status": "found", "value": "정제(tablet) 제품의 용출 시험·OOS/OOT 조사, 공정 변수 관리, 설비 세척·유지 및 공급업체 관리 업무가 해당한다.", "evidence": [{"field": "상세.본문발췌", "quote": "Your firm failed to establish and follow adequate written procedures for cleaning and maintenance of equipment (21 CFR 211.67(b))"}]}, "recommendation": {"status": "found", "value": "회신에 OOS 결과의 회고적 독립 검토, 조사·CAPA 시스템 평가, 원료·공급업체 시스템 검토 등을 포함하도록 요구했고, 적격 컨설턴트를 선임해 6대 시스템 감사를 수행하도록 권고했다.", "evidence": [{"field": "상세.본문발췌", "quote": "you should engage a consultant qualified as set forth in 21 CFR 211.34 to assist your firm in meeting CGMP requirements"}]}, "effective_date": {"status": "not_stated", "value": "", "evidence": []}, "response_deadline": {"status": "found", "value": "within fifteen business days of receipt of this letter", "evidence": [{"field": "상세.본문발췌", "quote": "Send your written response to CDER-OC-OMQ-Communications@fda.hhs.gov within fifteen business days of receipt of this letter"}]}, "reviewed_at": "2026-11-25", "model": "claude-code-action", "source_url": "https://www.fda.gov/inspections-compliance-enforcement-and-criminal-investigations/warning-letters/alkem-laboratories-limited-736113-11182026", "scope": "확보한 본문 기준 · 첨부 및 미확보 페이지는 제외 · 자동 추출"}, "content_scope": "case", "scope_reason": "공식 자료 유형: 실사·처분·시장조치", "topics": ["validation", "process-validation", "stability", "deviation-capa", "quality-system", "laboratory", "documentation", "supply"], "classification_method": "source-keywords-v1",