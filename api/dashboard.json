mmary_status": "fallback", "summary_coverage": "structured_excerpt", "summary_quality": "automated_checks_only", "summary_review": null, "change_summary": "성상 부적합", "impact_summary": "", "background": "", "purpose": "", "changes_before": "", "changes_after": "", "affected_work": "", "recommendation": "", "key_quote": "", "importance": "보통", "tags": "", "created_at": "2026-11-04", "link": "https://nedrug.mfds.go.kr/pbp/CCBAI01/getItem?limit=20&page=1&searchTypeCode=A&targetItemSeq=202603519", "content_scope": "case", "scope_reason": "공식 자료 유형: 실사·처분·시장조치", "topics": [], "classification_method": "source-keywords-v1", "classification_status": "insufficient_text", "inspection_end_date": "", "official_published_at": "", "first_seen_at": "2026-11-04", "last_collected_at": "2026-11-04", "collection_mode": "daily", "investigators": [], "source_link": {"kind": "document", "label": "공식 자료 열기", "url": "https://nedrug.mfds.go.kr/pbp/CCBAI01/getItem?limit=20&page=1&searchTypeCode=A&targetItemSeq=202603519"}, "fei": "", "inspection_id": "", "facility_address": "", "record_kind": "document", "link_check": {"status": "http_ok", "http_status": 200}, "source_collection_status": "", "document_resolution": null}, {"id": "c0d0b77e8aea3606afce605c", "title": "Recommendations for Reducing the Risk of Transfusion-Transmitted Hepatitis B Virus; Guidance for Industry; Availability", "country": "미국", "facility_country": "", "agency": "FDA", "published_date": "2026-11-03", "source_title": "FDA 공고·가이드라인", "source_type": "FDA 공고·가이드라인", "company": "", "cfr": "", "ai_summary": "FDA가 수혈 전파 B형간염 바이러스(HBV) 위험 감소를 위한 최종 가이던스의 공개를 알렸다. 혈액·혈장 채집기관의 HBV 검사 권고를 다루며 2025년 7월 초안을 확정하고 과거 문서들을 대체한다(수집된 요약 발췌 기준이며 일부 잘려 있다).", "source_summary": "The Food and Drug Administration (FDA or Agency) is announcing the availability of a final guidance titled \"Recommendations for Reducing the Risk of Transfusion-Transmitted Hepatitis B Virus.\" The guidance document provides blood establishments that collect blood and blood components, including Source Plasma, with FDA's recommendations for testing blood and blood components for hepatitis B virus (HBV) to reduce the risk of transfusion-transmitted HBV. The recommendations contained in the guidance apply to the collection of Whole Blood and blood components, including Source Plasma. The guidance announced in this notice finalizes the draft guidance titled \"Recommendations for Testing Blood Donations for Hepatitis B Surface Antigen\" (July 2025 Draft Guidance). The guidance also supersedes the documents titled \"Recommendations for the Management of Donors and Units that are Initially Reactive for Hepatitis B Surface Antigen (HBsAg)\" (December 1987 Memorandum), \"FDA Recommendations Concerni", "summary_provider": "claude", "summary_model": "claude-code-action", "summary_status": "success", "summary_coverage": "structured_excerpt", "summary_quality": "automated_checks_only", "summary_review": {"method": "근거 인용 자동 일치 검사 · 독립 검수 아님", "reviewed_at": "2026-11-03", "scope": "공식 구조화 필드와 근거 인용을 자동 대조했습니다. 원문 전체의 사람 검수를 뜻하지 않습니다.", "source_url": "https://www.federalregister.gov/documents/2026/11/03/2026-22369/recommendations-for-reducing-the-risk-of-transfusion-transmitted-hepatitis-b-virus-guidance-for", "visual_review": false}, "change_summary": "FDA가 수혈 전파 B형간염 바이러스(HBV) 위험 감소를 위한 최종 가이던스의 공개를 알렸다. 혈액·혈장 채집기관의 HBV 검사 권고를 다루며 2025년 7월 초안을 확정하고 과거 문서들을 대체한다(수집된 요약 발췌 기준이며 일부 잘려 있다).", "impact_summary": "", "background": "", "purpose": "", "changes_before": "", "changes_after": "", "affected_work": "", "recommendation": "", "key_quote": "", "importance": "보통", "tags": "RA, QC", "created_at": "2026-11-03", "link": "https://www.federalregister.gov/documents/2026/11/03/2026-22369/recommendations-for-reducing-the-risk-of-transfusion-transmitted-hepatitis-b-virus-guidance-for", "content_scope": "guidance", "scope_reason": "규정·가이드라인 유형 또는 명시적 GMP 단서", "topics": [], "classification_method": "source-keywords-v1", "classification_status": "pending", "inspection_end_date": "", "official_published_at": "", "first_seen_at": "2026-11-03", "last_collected_at": "2026-11-03", "collection_mode": "daily", "investigators": [], "source_link": {"kind": "document", "label": "공식 자료 열기", "url": "https://www.federalregister.gov/documents/2026/11/03/2026-22369/recommendations-for-reducing-the-risk-of-transfusion-transmitted-hepatitis-b-virus-guidance-for"}, "fei": "", "inspection_id": "", "facility_address": "", "record_kind": "document", "link_check": {"status": "http_ok", "http_status": 206}, "source_collection_status": "", "document_resolution": null}, {"id": "e081e4d145325220de448632", "title": "Potency Assurance for Cellular and Gene Therapy Products; Guidance for Industry; Availability", "country": "미국", "facility_country": "", "agency": "FDA", "published_date": "2026-11-03", "source_title": "FDA 공고·가이드라인", "source_type": "FDA 공고·가이드라인", "company": "", "cfr": "", "ai_summary": "FDA가 세포·유전자치료제(CGT)의 역가 보증(potency assurance)에 관한 최종 가이던스 'Potency Assurance for Cellular and Gene Therapy Products'의 공개를 알렸다. 품질 위험관리에 기반해 제품 전 주기의 역가 보증과 허가 제품의 로트 출하시험 요건을 다루며, 2023년 12월 28일 초안을 확정한 것이다(수집된 요약 발췌 기준).", "source_summary": "The Food and Drug Administration (FDA or Agency) is announcing the availability of a final guidance titled \"Potency Assurance for Cellular and Gene Therapy Products.\" The guidance document provides recommendations to help assure the potency of human cellular therapy or gene therapy (CGT) products at all stages of the product lifecycle. FDA is recommending a comprehensive approach to potency assurance of CGT products that is grounded in quality risk management. For investigational products, we describe how to progressively implement a strategy for potency assurance during product development and provide additional considerations to help assure the potency of products that are undergoing rapid clinical development. For licensed products, we describe requirements for potency assurance, including testing required for lot release assays. The guidance announced in this notice finalizes the draft guidance of the same title issued on December 28, 2023.", "summary_provider": "claude", "summary_model": "claude-code-action", "summary_status": "success", "summary_coverage": "structured_excerpt", "summary_quality": "automated_checks_only", "summary_review": {"method": "근거 인용 자동 일치 검사 · 독립 검수 아님", "reviewed_at": "2026-11-03", "scope": "공식 구조화 필드와 근거 인용을 자동 대조했습니다. 원문 전체의 사람 검수를 뜻하지 않습니다.", "source_url": "https://www.federalregister.gov/documents/2026/11/03/2026-22427/potency-assurance-for-cellular-and-gene-therapy-products-guidance-for-industry-availability", "visual_review": false}, "change_summary": "FDA가 세포·유전자치료제(CGT)의 역가 보증(potency assurance)에 관한 최종 가이던스 'Potency Assurance for Cellular and Gene Therapy Products'의 공개를 알렸다. 품질 위험관리에 기반해 제품 전 주기의 역가 보증과 허가 제품의 로트 출하시험 요건을 다루며, 2023년 12월 28일 초안을 확정한 것이다(수집된 요약 발췌 기준).", "impact_summary": "", "background": "", "purpose": "", "changes_before": "", "changes_after": "", "affected_work": "", "recommendation": "", "key_quote": "", "importance": "보통", "tags": "RA, QC", "created_at": "2026-11-03", "link": "https://www.federalregister.gov/documents/2026/11/03/2026-22427/potency-assurance-for-cellular-and-gene-therapy-products-guidance-for-industry-availability", "content_scope": "guidance", "scope_reason": "규정·가이드라인 유형 또는 명시적 GMP 단서", "topics": [], "classification_method": "source-keywords-v1", "classification_status": "pending", "inspection_end_date": "", "official_published_at": "", "first_seen_at": "2026-11-03", "last_collected_at": "2026-11-03", "collection_mode": "daily", "investigators": [], "source_link": {"kind": "document", "label": "공식 자료 열기", "url": "https://www.federalregister.gov/documents/2026/11/03/2026-22427/potency-assurance-for-cellular-and-gene-therapy-products-guidance-for-industry-availability"}, "fei": "", "inspection_id": "", "facility_address": "", "record_kind": "document", "link_check": {"status": "http_ok", "